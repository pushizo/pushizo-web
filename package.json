{
  "name": "@herosignal/web",
  "version": "0.1.0",
  "description": "HeroSignal Web SDK: izin istemi, Web Push aboneliği, kullanıcı/tag yönetimi, olaylar ve service worker",
  "license": "MIT",
  "homepage": "https://github.com/exec0de/herosignal/tree/main/sdk/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exec0de/herosignal.git",
    "directory": "sdk/web"
  },
  "bugs": {
    "url": "https://github.com/exec0de/herosignal/issues"
  },
  "keywords": [
    "herosignal",
    "push",
    "notifications",
    "web-push",
    "email",
    "sms"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./sw": "./dist/HeroSignalSDKWorker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "size": "node size-check.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5"
  },
  "sideEffects": false
}
